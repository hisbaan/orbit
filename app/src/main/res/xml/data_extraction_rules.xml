<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing is backed up or copied to a new phone. The settings hold API keys and tokens
    encrypted with a key that never leaves this phone's Keystore: copied elsewhere they can't be
    decrypted and would read as blank.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
