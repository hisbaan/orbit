<?xml version="1.0" encoding="utf-8"?>
<!--
    Only the settings are backed up and copied to a new phone: provider, model, playlists, Home
    Assistant address, sounds, voice. Not the secrets (datastore/secrets.preferences_pb): they're
    encrypted with a key that never leaves this phone's Keystore and couldn't be decrypted
    elsewhere; the settings note which were set, so Orbit asks for them again. Not the event log.
-->
<data-extraction-rules>
    <!-- Only when the backup is end-to-end encrypted (with the screen lock). -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
