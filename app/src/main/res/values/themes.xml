<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Orbit" parent="android:Theme.Material.NoActionBar" />

    <!-- Activities that only hand off (triggers) or show a system prompt (unlock). -->
    <style name="Theme.Orbit.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
