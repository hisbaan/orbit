<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing is done with events: ScreenControlService reads another app's windows only while an
    action runs (saving a reminder in Google Tasks, Maps' navigation screen), polling for the view
    it needs. Screenshots and taps are for map labels, which Maps draws without views.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/screen_control_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="100" />
